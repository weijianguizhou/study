\section{动力学基础与输运定理}

\subsection{质点运动学与动力学}
在惯性系 $\mathcal{I}$ 中，质点的动量定义为 $\mathbf{p} = m\mathbf{v}$。牛顿第二定律给出：
\begin{equation}
    \mathbf{F} = \frac{d\mathbf{p}}{dt} = m\mathbf{a} \quad (\text{当 } m \text{ 为常数时})
\end{equation}

\subsection{输运定理 (Transport Theorem) —— 核心推导基础}
由于航天器的测量通常在随体坐标系 $\mathcal{B}$ 中进行，而物理定律定义在惯性系 $\mathcal{I}$ 中。设 $\mathbf{A}$ 为任意矢量，其在两系间的导数关系为：
\begin{equation}
    \left( \frac{d\mathbf{A}}{dt} \right)_{\mathcal{I}} = \left( \frac{d\mathbf{A}}{dt} \right)_{\mathcal{B}} + \bm{\omega}^{\mathcal{B/I}} \times \mathbf{A}
\end{equation}
其中 $\bm{\omega}^{\mathcal{B/I}}$ 是坐标系 $\mathcal{B}$ 相对于 $\mathcal{I}$ 的角速度。

\section{刚体动力学推导}

\subsection{角动量与惯性张量}
对于刚体，其角动量 $\mathbf{H}$ 是所有质量元 $dm$ 的角动量之和：
\begin{equation}
    \mathbf{H} = \int \mathbf{r} \times \mathbf{v} dm = \int \mathbf{r} \times (\bm{\omega} \times \mathbf{r}) dm
\end{equation}
利用矢量三重积公式 $\mathbf{a} \times (\mathbf{b} \times \mathbf{c}) = \mathbf{b}(\mathbf{a} \cdot \mathbf{c}) - \mathbf{c}(\mathbf{a} \cdot \mathbf{b})$，推导出：
\begin{equation}
    \mathbf{H} = \left[ \int (r^2 \mathbf{E} - \mathbf{r}\mathbf{r}^T) dm \right] \bm{\omega} = \mathbf{I} \bm{\omega}
\end{equation}
其中 $\mathbf{I}$ 称为\textbf{惯性张量}（或惯性矩阵）：
\begin{equation}
    \mathbf{I} = \begin{bmatrix} 
        I_{xx} & -I_{xy} & -I_{xz} \\ 
        -I_{yx} & I_{yy} & -I_{yz} \\ 
        -I_{zx} & -I_{zy} & I_{zz} 
    \end{bmatrix}
\end{equation}

\subsection{欧拉动力学方程推导}
根据角动量定理：$\mathbf{M} = \dot{\mathbf{H}}_{\mathcal{I}}$。应用输运定理：
\begin{equation}
    \mathbf{M} = \left( \frac{d\mathbf{H}}{dt} \right)_{\mathcal{B}} + \bm{\omega} \times \mathbf{H}
\end{equation}
由于在随体坐标系中，刚体的形状固定，故 $\dot{\mathbf{I}} = 0$。代入 $\mathbf{H} = \mathbf{I}\bm{\omega}$：
\begin{equation}
    \mathbf{M} = \mathbf{I}\dot{\bm{\omega}} + \bm{\omega} \times (\mathbf{I}\bm{\omega})
\end{equation}


\section{典型例题}

\begin{tcolorbox}[title=例题 1：无力矩状态下的自旋, colback=blue!5!white, colframe=blue!75!black]
一个对称航天器 ($I_x = I_y \neq I_z$) 在太空中做自由转动（外力矩 $\mathbf{M}=0$）。请根据欧拉方程求其角速度的变化规律。

\textbf{解：}
代入欧拉方程，由于 $M_x=M_y=M_z=0$ 且 $I_x=I_y$：
\begin{align}
    I_x \dot{\omega}_x - (I_x - I_z) \omega_y \omega_z &= 0 \quad \dots (1)\\
    I_x \dot{\omega}_y - (I_z - I_x) \omega_z \omega_x &= 0 \quad \dots (2)\\
    I_z \dot{\omega}_z &= 0 \quad \dots (3)
\end{align}
由 (3) 得：$\omega_z = \Omega$（常数）。
定义常数 $\lambda = \Omega \frac{I_z - I_x}{I_x}$，则前两式变为：
\begin{equation}
    \dot{\omega}_x + \lambda \omega_y = 0, \quad \dot{\omega}_y - \lambda \omega_x = 0
\end{equation}
这是一个谐振子方程，解得角速度在 $x-y$ 平面内做圆周运动（进动）：
\begin{equation}
    \omega_x(t) = A \cos(\lambda t + \phi), \quad \omega_y(t) = A \sin(\lambda t + \phi)
\end{equation}
\end{tcolorbox}

\begin{tcolorbox}[title=例题 2：转动动能计算, colback=green!5!white, colframe=green!50!black]
已知航天器惯性矩阵为 $\mathbf{I} = \text{diag}(100, 150, 200) \text{ kg}\cdot\text{m}^2$，当前角速度 $\bm{\omega} = [0.1, 0, 0.2]^T \text{ rad/s}$。求其转动动能 $T$。

\textbf{解：}
转动动能公式：$T = \frac{1}{2} \bm{\omega}^T \mathbf{I} \bm{\omega}$。
\begin{align*}
    T &= \frac{1}{2} [0.1, 0, 0.2] \begin{bmatrix} 100 & 0 & 0 \\ 0 & 150 & 0 \\ 0 & 0 & 200 \end{bmatrix} \begin{bmatrix} 0.1 \\ 0 \\ 0.2 \end{bmatrix} \\
    &= \frac{1}{2} (100 \times 0.1^2 + 200 \times 0.2^2) \\
    &= \frac{1}{2} (1 + 8) = 4.5 \text{ Joules}
\end{align*}
\end{tcolorbox}


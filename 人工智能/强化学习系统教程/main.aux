\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces PPO-Clip 目标函数的几何解释。蓝色曲线对应 $\hat  {A}>0$ 的情况：$r_t$ 从 1 增大时目标函数上升，但越过 $1+\epsilon $ 后被裁平（梯度为零）。红色曲线对应 $\hat  {A}<0$ 的情况：$r_t$ 从 1 减小时目标函数上升，但越过 $1-\epsilon $ 后被裁平。}}{96}{figure.caption.25}\protected@file@percent }
\newlabel{fig:ppo_clip}{{7.4}{96}{PPO-Clip 目标函数的几何解释。蓝色曲线对应 $\hat {A}>0$ 的情况：$r_t$ 从 1 增大时目标函数上升，但越过 $1+\epsilon $ 后被裁平（梯度为零）。红色曲线对应 $\hat {A}<0$ 的情况：$r_t$ 从 1 减小时目标函数上升，但越过 $1-\epsilon $ 后被裁平。}{figure.caption.25}{}}

    [×], [1], [×], [×], [全为 1],
    [×], [×], [1], [×], [全为 1],
    [1], [0], [0], [000], [$overline(Y)_0 = 0$，其余为 1],
    [1], [0], [0], [001], [$overline(Y)_1 = 0$，其余为 1],
    [1], [0], [0], [010], [$overline(Y)_2 = 0$，其余为 1],
    [1], [0], [0], [011], [$overline(Y)_3 = 0$，其余为 1],
    [1], [0], [0], [100], [$overline(Y)_4 = 0$，其余为 1],
